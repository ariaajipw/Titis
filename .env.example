# Supabase (development)
# Gunakan `supabase start` untuk Supabase lokal, lalu salin nilai dari output CLI.
# JANGAN gunakan service_role key di frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: untuk development yang memerlukan akses admin (hanya server-side / Supabase CLI)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=